# Qdrant Cloud
QDRANT_HOST="https://<your-cluster-id>.<region>.gcp.cloud.qdrant.io"
QDRANT_PORT=6333
QDRANT_API_KEY="<your-qdrant-api-key>"
QDRANT_COLLECTION="legal_chunks_v1"

# Neon PostgreSQL
DATABASE_DSN="postgresql://<user>:<password>@<neon-hostname>/<database>?sslmode=require"

# Upstash Redis
REDIS_DSN="rediss://default:<password>@<upstash-endpoint>:6379"
CACHE_TTL_SECONDS=86400

# Local LLM (Ollama)
OLLAMA_HOST="127.0.0.1:11434"
OLLAMA_MODEL_NAME="qwen3:4b-instruct-2507-q4_K_M"
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.90
LLM_MAX_TOKENS=1024
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_GPU=-1
OLLAMA_KEEP_ALIVE="30m"
ANSWER_MAX_TOKENS=450
PLANNER_ENABLED=false

# Retrieval & Reranker
EMBEDDING_MODEL_PATH="BAAI/bge-m3"
RERANKER_MODEL_PATH="BAAI/bge-reranker-v2-m3"
TOP_K_RETRIEVAL=25
TOP_N_RERANK=5
RERANK_SCORE_THRESHOLD=0.35
